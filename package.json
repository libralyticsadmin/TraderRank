{
  "name": "traderrank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TraderRank - Broker & Trading Platform Ingestion Infrastructure",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build && (mkdir -p dist && cp -r client/dist/* dist/ 2>/dev/null || true)",
    "vercel-build": "npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
