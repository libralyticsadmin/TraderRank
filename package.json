{
  "name": "traderrank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TraderRank - Broker & Trading Platform Ingestion Infrastructure",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm run --workspace=traderrank-client build",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "vercel-build": "npm run --workspace=traderrank-client build",
    "export:i18n": "node scripts/exportTranslationsToExcel.js",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "exceljs": "^4.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
